# ============================================================================
# ShubhVivah Studio — Wedding Invitation Video Maker Environment Configuration
# ============================================================================

# Application Base URL (used for WhatsApp share links & signed download URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin Dashboard Authentication Passcode
# Used to log in at /admin
ADMIN_PASSCODE=shubhvivah-admin-2026

# Secret key for signing expiring download URLs & private media access tokens
DOWNLOAD_SIGNING_SECRET=shubhvivah-hmac-signing-secret-key-2026-prod

# Storage & Database Mode:
# Set STORAGE_MODE=supabase when NEXT_PUBLIC_SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are configured.
# Defaults to 'local' which uses persistent local storage in ./data/ for immediate zero-config operation.
STORAGE_MODE=local

# Supabase Configuration (Required only when STORAGE_MODE=supabase)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Video Rendering Defaults
DEFAULT_VIDEO_WIDTH=1080
DEFAULT_VIDEO_HEIGHT=1920
DEFAULT_VIDEO_FPS=30
DOWNLOAD_LINK_EXPIRY_HOURS=72
MAX_PHOTO_UPLOAD_MB=10
MAX_AUDIO_UPLOAD_MB=25
