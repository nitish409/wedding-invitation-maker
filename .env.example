# ============================================================================
# ShubhVivah Studio — Wedding Invitation Video Maker Environment Configuration
# ============================================================================

# Application Base URL (used for WhatsApp share links & signed download URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin Dashboard Authentication Passcode
# Used to log in at /admin
ADMIN_PASSCODE=shubhvivah-admin-2026

# Secret key for signing expiring download URLs & private media access tokens
DOWNLOAD_SIGNING_SECRET=shubhvivah-hmac-signing-secret-key-2026-prod

# ============================================================================
# Supabase Persistent Storage & Database Configuration (Serverless / Vercel)
# ============================================================================
# When NEXT_PUBLIC_SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY (or NEXT_PUBLIC_SUPABASE_ANON_KEY)
# are configured, the application automatically persists all uploaded photos,
# custom audio tracks, rendered MP4 videos, and wedding invitation projects
# in Supabase Storage & PostgreSQL — never writing to /var/task.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional custom Supabase Storage bucket names (automatically created if using SUPABASE_SERVICE_ROLE_KEY):
SUPABASE_PHOTOS_BUCKET=private-photos
SUPABASE_AUDIO_BUCKET=custom-audio
SUPABASE_RENDERS_BUCKET=rendered-videos

# Video Rendering Defaults
DEFAULT_VIDEO_WIDTH=1080
DEFAULT_VIDEO_HEIGHT=1920
DEFAULT_VIDEO_FPS=30
DOWNLOAD_LINK_EXPIRY_HOURS=72
MAX_PHOTO_UPLOAD_MB=10
MAX_AUDIO_UPLOAD_MB=25
